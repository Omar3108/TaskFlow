# Copy this file to .env and adjust the values. Never commit .env.
# These values are local-development defaults only; production uses real secrets set in the host.

# --- PostgreSQL container (docker-compose.yml) ---
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow
POSTGRES_PORT=5432

# --- Backend (Spring Boot) ---
# Spring does not read .env: export these variables (or set them in your IDE) to override the defaults.
DB_URL=jdbc:postgresql://localhost:5432/taskflow
DB_USERNAME=taskflow
DB_PASSWORD=taskflow

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:8080
