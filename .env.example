# Copy this file to .env and adjust the values. Never commit .env.
# These values are local-development defaults only; production uses real secrets set in the host.
# Both docker-compose and the backend (through spring.config.import) read the .env file.

# --- PostgreSQL container (docker-compose.yml) ---
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow
POSTGRES_PORT=5432

# --- Backend: database ---
DB_URL=jdbc:postgresql://localhost:5432/taskflow
DB_USERNAME=taskflow
DB_PASSWORD=taskflow

# --- Backend: authentication ---
# Base64-encoded HMAC key, at least 32 bytes. The value below is a public placeholder that only
# makes local development work out of the box. Generate your own with: openssl rand -base64 32
JWT_SECRET=ZGV2LW9ubHktc2VjcmV0LWRvLW5vdC11c2UtaW4tcHJvZHVjdGlvbg==
JWT_ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
# The refresh cookie is HTTPS-only by default. false is acceptable only on localhost.
COOKIE_SECURE=false
# Comma-separated browser origins allowed to call the API directly (CORS).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Demo sandboxes ("Try the demo" on the login page) ---
DEMO_ENABLED=true
DEMO_TTL=24h
DEMO_MAX_PER_IP_PER_HOUR=5
DEMO_MAX_ACTIVE=300

# --- Database pool (free database plans allow few connections) ---
DB_POOL_SIZE=5

# --- Ports ---
# API port. If you change it, change VITE_API_PROXY_TARGET to match.
PORT=8080

# --- Whole app in Docker (docker compose --profile app up -d --build) ---
# Port of the web container on the host; the API is reached through it at /api.
WEB_PORT=3000

# --- Frontend (Vite dev server) ---
# Where the dev server forwards /api requests.
VITE_API_PROXY_TARGET=http://localhost:8080
